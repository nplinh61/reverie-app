# Reverie local development environment variables.
#
# Copy this file to .env and adjust as needed:
#   Copy-Item .env.example .env   (Windows PowerShell)
#   cp .env.example .env          (Linux / macOS)
#
# .env is git-ignored and must never be committed. Only this .env.example,
# which holds non-secret local values, is tracked.
#
# These variables are consumed by BOTH:
#   - infra/docker-compose.yml (the PostgreSQL and Mailpit containers), and
#   - the Spring Boot application (apps/api) datasource and mail configuration.

# Database name and credentials.
DB_NAME=reverie
DB_USER=reverie
DB_PASSWORD=reverie_local_dev

# Host-side PostgreSQL port.
# PostgreSQL listens on 5432 inside the container. DB_PORT is the port published
# on the Windows host that the Spring Boot application connects to. Change it
# only if 5432 is already in use locally; then both Compose and the app use it.
DB_PORT=5433

# Email (local development uses the Mailpit container; see ADR-005).
# MAIL_PORT is the host SMTP port the app sends to; MAILPIT_UI_PORT serves the
# web inbox at http://localhost:8025. No authentication or TLS locally.
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
# Sender identity shown on verification and account-notice emails.
MAIL_FROM=no-reply@reverie.local
MAIL_FROM_NAME=Reverie

# Public origin used to build the verification link sent in emails. In local
# development this is the Angular dev server, which handles /verify-email and
# then calls the backend verify endpoint.
APP_BASE_URL=http://localhost:4201
