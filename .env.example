# Reverie local development environment variables.
#
# Copy this file to .env and adjust as needed:
#   Copy-Item .env.example .env   (Windows PowerShell)
#   cp .env.example .env          (Linux / macOS)
#
# .env is git-ignored and must never be committed. Only this .env.example,
# which holds non-secret local values, is tracked.
#
# These variables are consumed by BOTH:
#   - infra/docker-compose.yml (the PostgreSQL container), and
#   - the Spring Boot application (apps/api) datasource configuration.

# Database name and credentials.
DB_NAME=reverie
DB_USER=reverie
DB_PASSWORD=reverie_local_dev

# Host-side PostgreSQL port.
# PostgreSQL listens on 5432 inside the container. DB_PORT is the port published
# on the Windows host that the Spring Boot application connects to. Change it
# only if 5432 is already in use locally; then both Compose and the app use it.
DB_PORT=5432
